TZ=Asia/Seoul
COUPANG_WING_ID=your-wing-login-id
COUPANG_WING_PASSWORD=your-wing-login-password
COUPON_WEB_USER=admin
COUPON_WEB_PASSWORD=change-this-to-a-long-random-password

# 127.0.0.1 means only NAS localhost/reverse proxy can access the web UI.
# Use 0.0.0.0 only if you understand the network exposure.
COUPON_WEB_BIND=127.0.0.1
