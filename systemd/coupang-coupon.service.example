[Unit]
Description=Coupang WING daily coupon automation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/coupang-coupon
EnvironmentFile=/etc/coupang-coupon.env
ExecStart=/opt/coupang-coupon/.venv/bin/python /opt/coupang-coupon/daily_coupon_runner.py --run
